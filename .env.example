# ============================================
# REMOTE SUPPORT APP - .env.example
# ============================================
# Copiar a .env y llenar con valores reales

# ============================================
# Backend - Servidor de Señalización
# ============================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8443
SIGNAL_WS_PORT=8080
SIGNAL_HTTPS_PORT=8443
SIGNAL_TLS_CERT=./certs/server.crt
SIGNAL_TLS_KEY=./certs/server.key

# ============================================
# ICE / STUN / TURN
# ============================================
STUN_PORT=3478
TURN_PORT=5349
TURN_TLS_PORT=5349
TURN_RELAY_REALM=remote-support.local
TURN_ADMIN_USER=admin
TURN_ADMIN_PASSWORD=admin123
TURN_MAX_CONNECTIONS=1000
TURN_MAX_BPS_PER_CONNECTION=1000000
TURN_EXTERNAL_IP=123.123.123.123
ICE_RESTART_THRESHOLD=3
ICE_MAX_RETRIES=10

# ============================================
# Streaming / Video
# ============================================
FPS_TARGET=60
FPS_MIN=15
FPS_MAX=60
VIDEO_ENCODER=nvenc
VIDEO_BITRATE=6000000
VIDEO_HEIGHT=1080
VIDEO_WIDTH=1920
VIDEO_QUALITY=75
VIDEO_FPS=60
VIDEO_MAX_FPS=60
VIDEO_NORMALIZE_DPI=true

# ============================================
# Red / Congestion Control
# ============================================
CONGESTION_CONTROL=gcc
GCC_INITIAL_BANDWIDTH=1000000
GCC_MIN_BANDWIDTH=100000
GCC_MAX_BANDWIDTH=10000000
BUFFER_TARGET_MS=300
NETWORK_PROBE_INTERVAL=5000

# ============================================
# Seguridad
# ============================================
ENCRYPTION_ENABLED=true
DTLS_VERSION=1.3
SRTP_CIPHER=xchacha20-poly1305
ENFORCE_E2EE=true
WEAK_SIGNAL_TIMEOUT=30000
MAX_SESSION_DURATION=3600

# ============================================
# Logs
# ============================================
LOG_LEVEL=info
LOG_FILE=./logs/remote-support-app.log
LOG_FORMAT=json

# ============================================
# Deploy
# ============================================
# Production mode
# SERVER_MODE=production
# Development mode (default)
SERVER_MODE=development
