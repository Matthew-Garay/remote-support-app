{
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/build": true,
    "**/target": true,
    "**/node_modules": true
  },
  "search.exclude": {
    "**/build": true,
    "**/target": true,
    "**/node_modules": true
  },
  "editor.formatOnSave": true,
  "editor.rulers": [120],
  "[dart]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "Dart-Code.dart-code"
  },
  "[rust]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "rust-analyzer.cargo.target": "x86_64-pc-windows-msvc",
  "rust-analyzer.checkOnSave": true,
  "rust-analyzer.features": ["all"],
  "cSpell.words": [
    "flutter_rust_bridge",
    "DESU",
    "GCC",
    "QUIC",
    "SRTP",
    "DTLS",
    "NAT",
    "P2P",
    "XChaCha20",
    "YUV420",
    "NVENC",
    "QuickSync",
    "VideoToolbox",
    "PipeWire",
    "Wayland",
    "DXGI",
    "SendInput",
    "uinput",
    "CGEvent",
    "ScreenCaptureKit",
    "flutter",
    "dart",
    "cargo",
    "actix",
    "tokio"
  ]
}
